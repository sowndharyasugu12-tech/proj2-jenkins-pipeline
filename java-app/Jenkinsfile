pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        DOCKER_HUB_USER = "9500588005"
    }

    stages {

        stage('Clone Code') {
            steps {
                git ' https://github.com/sowndharyasugu12-tech/proj2-jenkins-pipeline.git'
            }
        }

        stage('Build') {
            steps {
                dir('java-app') {
                sh 'mvn clean package'
                }
            }
        }

        stage('Unit Test') {
            steps {
                 dir('java-app') {
                sh 'mvn test'
                 }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    // Resolve SonarScanner tool path
                    def scannerHome = tool name: 'sonar-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'

                    // Run analysis with SonarQube environment
                    withSonarQubeEnv('MySonarQubeServer') {
                        sh "${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=proj2-jenkins-pipeline \
                            -Dsonar.sources=java-app/src \
                            -Dsonar.java.binaries=java-app/target/classes"
                    }
                }
            }
        }

  stage('Docker Build & Push') {
    steps {
        script {
            withDockerRegistry(credentialsId: 'dockerhub-credentials', url: '') {
                sh """
                    docker build \
                        -t  $DOCKER_HUB_USER/proj2-jenkins-pipeline:${env.BUILD_NUMBER} \
                        -t  $DOCKER_HUB_USER/proj2-jenkins-pipeline:latest \
                        java-app

                    docker push $DOCKER_HUB_USER/proj2-jenkins-pipeline:${env.BUILD_NUMBER}
                    docker push $DOCKER_HUB_USER/proj2-jenkins-pipeline:latest
                """
            }
        }
    }
}

       stage('Deploy to myproject2 Cluster') {
    steps {
        withCredentials([string(credentialsId: 'kubeconfig-myproject2', variable: 'KUBECONFIG_DATA')]) {
            sh '''
                echo "$KUBECONFIG_DATA" | base64 --decode > $WORKSPACE/kubeconfig
                export KUBECONFIG=$WORKSPACE/kubeconfig
                # Switch to the correct context
                kubectl config use-context kind-myproject2
                kind load docker-image $DOCKER_HUB_USER/proj2-jenkins-pipeline:${BUILD_NUMBER} --name myproject2
                sed -i "s|image: .*|image: $DOCKER_HUB_USER/proj2-jenkins-pipeline:${BUILD_NUMBER}|g" java-app/k8s/deployment.yml
                sh 'kubectl apply -f k8s/rbac-endpointslice.yml'
                kubectl apply -f java-app/k8s/deployment.yml
                kubectl apply -f java-app/k8s/service.yml
                kubectl rollout status deployment/java-app --timeout=120s
                kubectl get pods
                kubectl get svc
            '''
        }
    }
}
    stage('Verify Service') {
    steps {
        sh '''
            export KUBECONFIG=$WORKSPACE/kubeconfig

            echo "Services:"
            kubectl get svc
            # Optional: curl the NodePort/LoadBalancer endpoint
            NODE_PORT=$(kubectl get svc java-service -o jsonpath='{.spec.ports[0].nodePort}')
            NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[0].address}')
            echo "Testing app endpoint..."
            curl --fail http://$NODE_IP:$NODE_PORT || exit 1
        '''
    }
}
}

    post {

        success {
            echo 'Pipeline Success'
        }

        failure {
            echo 'Pipeline Failed'
        }
    }
}
